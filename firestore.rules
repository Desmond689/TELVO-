rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isCompletedJob(data) {
      return data.status == 'completed' || data.status == 'reviewed';
    }

    function isOpenJobStatus(status) {
      return status in ['posted', 'open', 'quotes_received', 'notified'];
    }

    function isChatParticipant(chatId) {
      return canUseApp() &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
    }

    function getUserDoc(userId) {
      return get(/databases/$(database)/documents/users/$(userId));
    }

    function isActiveUser() {
      return isSignedIn() &&
        getUserDoc(request.auth.uid).exists() &&
        getUserDoc(request.auth.uid).data.isSuspended != true &&
        getUserDoc(request.auth.uid).data.isBanned != true;
    }

    function isActiveAdmin() {
      return isAdmin() &&
        getUserDoc(request.auth.uid).exists() &&
        getUserDoc(request.auth.uid).data.isSuspended != true &&
        getUserDoc(request.auth.uid).data.isBanned != true;
    }

    function canUseApp() {
      return isActiveUser() || isActiveAdmin();
    }

    // Server-side mirror of the client-side block checks in chat_provider.dart
    // (sendMessage) and job_provider.dart (sendHireRequest). Without this,
    // blocking only worked as long as every client honored it — anyone
    // calling the Firestore SDK/REST API directly could message or send hire
    // requests to a user who blocked them.
    function isBlockedPair(userA, userB) {
      return (userA in get(/databases/$(database)/documents/users/$(userB)).data.get('blockedUsers', [])) ||
        (userB in get(/databases/$(database)/documents/users/$(userA)).data.get('blockedUsers', []));
    }

    match /usernames/{username} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || canUseApp());
      allow create: if isOwner(userId) &&
        request.resource.data.id == userId &&
        request.resource.data.userType in ['customer', 'professional', 'both'];
      allow update: if (isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['isVerified', 'isBanned', 'isPhoneVerified', 'isEmailVerified', 'isSuspended', 'accountStatus']) &&
        (!request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['mode']) || resource.data.userType == 'both')) || isAdmin();
      allow delete: if isAdmin();
    }

    match /jobs/{jobId} {
      allow read: if canUseApp() && (
        isAdmin() ||
        !isCompletedJob(resource.data) ||
        resource.data.customerId == request.auth.uid ||
        resource.data.professionalId == request.auth.uid
      );
      allow create: if canUseApp() &&
        request.resource.data.customerId == request.auth.uid &&
        request.resource.data.status in ['posted', 'open'];
      allow update: if canUseApp() && (
        isAdmin() ||
        resource.data.customerId == request.auth.uid ||
        resource.data.professionalId == request.auth.uid ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quotes', 'status']) &&
          isOpenJobStatus(resource.data.status))
      );
      allow delete: if canUseApp() &&
        (resource.data.customerId == request.auth.uid || isAdmin());
    }

    match /quotes/{quoteId} {
      allow read: if canUseApp();
      allow create: if canUseApp() &&
        request.resource.data.professionalId == request.auth.uid &&
        request.resource.data.jobId is string &&
        request.resource.data.price is number &&
        request.resource.data.status == 'pending' &&
        exists(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)) &&
        get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.customerId != request.auth.uid &&
        get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.status in ['posted', 'open', 'quotes_received', 'notified'];
      allow update: if canUseApp() && (
        isAdmin() ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']) &&
          request.resource.data.status in ['pending', 'accepted', 'rejected', 'expired'] &&
          (
            resource.data.professionalId == request.auth.uid ||
            get(/databases/$(database)/documents/jobs/$(resource.data.jobId)).data.customerId == request.auth.uid
          )
        )
      );
      allow delete: if isAdmin();
    }

    match /hire_requests/{hireId} {
      allow read: if canUseApp() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.professionalId == request.auth.uid ||
        isAdmin()
      );
      allow create: if canUseApp() &&
        request.resource.data.customerId == request.auth.uid &&
        !isBlockedPair(request.resource.data.customerId, request.resource.data.professionalId);
      allow update: if canUseApp() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.professionalId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if canUseApp() || isAdmin();
      allow create: if isActiveUser() &&
        request.resource.data.reviewerId == request.auth.uid &&
        request.resource.data.reviewedId != request.auth.uid &&
        request.resource.data.jobId is string &&
        request.resource.data.reviewedId is string &&
        request.resource.data.rating is number &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5 &&
        exists(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)) &&
        get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.customerId == request.auth.uid &&
        get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.professionalId == request.resource.data.reviewedId &&
        get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.status in ['completed', 'reviewed'];
      allow update, delete: if isAdmin();
    }

    match /chats/{chatId} {
      allow read, update: if canUseApp() &&
        request.auth.uid in resource.data.participantIds;
      allow create: if canUseApp() &&
        request.auth.uid in request.resource.data.participantIds &&
        !isBlockedPair(request.resource.data.user1Id, request.resource.data.user2Id);
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if canUseApp() && isChatParticipant(chatId);
        allow create: if canUseApp() && isChatParticipant(chatId) &&
          request.resource.data.senderId == request.auth.uid &&
          !isBlockedPair(request.resource.data.senderId, request.resource.data.receiverId);
        allow update: if canUseApp() && isChatParticipant(chatId) && (
          resource.data.senderId == request.auth.uid ||
          resource.data.receiverId == request.auth.uid
        );
        allow delete: if isAdmin();
      }
    }

    match /messages/{messageId} {
      allow read: if canUseApp() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid
      );
      allow create: if canUseApp() &&
        request.resource.data.senderId == request.auth.uid &&
        !isBlockedPair(request.resource.data.senderId, request.resource.data.receiverId);
      allow update: if canUseApp() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if canUseApp() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.professionalId == request.auth.uid ||
        isAdmin()
      );
      allow create: if canUseApp() &&
        request.resource.data.customerId == request.auth.uid;
      allow update: if canUseApp() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.professionalId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /wallets/{walletId} {
      allow read: if isOwner(walletId) || isAdmin();
      allow write: if false;
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /promotions/{promoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    match /app_config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /verifications/{verificationId} {
      allow read, create, update: if canUseApp() && (
        request.resource.data.userId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read, update, delete: if canUseApp() &&
        resource.data.userId == request.auth.uid;

      allow create: if canUseApp() &&
        (
          request.resource.data.userId == request.auth.uid
        ||
          (
            request.resource.data.fromUserId == request.auth.uid &&
            request.resource.data.userId is string &&
            request.resource.data.type in ['new_job','new_quote','quote_accepted','job_update','hire_request','hire_accepted','hire_rejected','job_completed','new_review'] &&
            !isBlockedPair(request.resource.data.fromUserId, request.resource.data.userId)
          )
        ) &&
        request.resource.data.keys().hasAll(['userId', 'title', 'body']) &&
        request.resource.data.keys().hasOnly(['userId', 'title', 'body', 'type', 'isRead', 'createdAt', 'pushSent', 'data', 'fromUserId']) &&
        request.resource.data.title is string &&
        request.resource.data.body is string;
    }

    match /reports/{reportId} {
      allow read: if canUseApp() && (
        resource.data.reportedBy == request.auth.uid || isAdmin()
      );
      allow create: if canUseApp() &&
        request.resource.data.reportedBy == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
