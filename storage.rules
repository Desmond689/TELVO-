rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidImage() {
      return request.resource.size < 10 * 1024 * 1024 // 10MB max
        && request.resource.contentType.matches('image/.*');
    }

    // Profile photos: /profile_photos/{userId}.jpg
    match /profile_photos/{fileName} {
      allow read: if true; // public profile photos
      allow write: if isSignedIn() &&
        fileName == request.auth.uid + '.jpg' && isValidImage();
    }

    // Job photos: /job_photos/{jobId}/{index}.jpg
    // Ownership is enforced at the application layer (only the job's
    // customer/professional can call uploadJobPhoto for a given jobId);
    // any signed-in user may read since job photos are shown to both sides.
    match /job_photos/{jobId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidImage();
    }

    // Portfolio photos: /portfolio_photos/{userId}/{index}.jpg
    match /portfolio_photos/{userId}/{fileName} {
      allow read: if true; // public portfolio
      allow write: if isSignedIn() && request.auth.uid == userId && isValidImage();
    }

    // Verification documents: private, owner + admin only
    match /verification_docs/{userId}/{fileName} {
      allow read: if isSignedIn() &&
        (request.auth.uid == userId || request.auth.token.admin == true);
      allow write: if isSignedIn() && request.auth.uid == userId &&
        request.resource.size < 15 * 1024 * 1024;
    }

    // App releases: /app_releases/{versionCode}.apk - public download,
    // upload restricted to admins via the web Admin > App Management page.
    match /app_releases/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.token.admin == true &&
        request.resource.size < 150 * 1024 * 1024;
    }

    // Deny everything else by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
